# ── Ключи и пароли — никогда ────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Твои агенты и рабочие файлы ─────────────────────────────────────────────
# По умолчанию собранные агенты в гит НЕ попадают: в них почти всегда есть
# данные клиентов. Хочешь хранить их в репозитории — убери строку «проекты/*»,
# но сначала проверь, что внутри нет ничего чужого.
проекты/*
входящие/*
результаты/*
корзина/*
!*/.gitkeep

# ── Мусор системы и инструментов ────────────────────────────────────────────
debug.log
*.log
node_modules/
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
Thumbs.db
desktop.ini
